{
  "$schema": "https://schema.railpack.com",
  "packages": { "dotnet": "10.0" },
  "steps": {
    "build": {
      "inputs": [{ "step": "packages:mise" }, { "local": true, "include": ["."] }],
      "commands": [
        "dotnet publish src/BpstAcademy.Web/BpstAcademy.Web.csproj -c Release -o out --self-contained --use-current-runtime"
      ],
      "variables": { "DOTNET_CLI_TELEMETRY_OPTOUT": "1", "DOTNET_NOLOGO": "1" }
    }
  },
  "deploy": {
    "aptPackages": ["libicu-dev"],
    "startCommand": "ASPNETCORE_URLS=http://0.0.0.0:${PORT:-3000} ./out/BpstAcademy.Web",
    "variables": {
      "ASPNETCORE_ENVIRONMENT": "Production",
      "ASPNETCORE_CONTENTROOT": "/app/out",
      "DOTNET_CLI_TELEMETRY_OPTOUT": "1"
    },
    "inputs": [{ "step": "build", "include": ["out"] }]
  }
}
