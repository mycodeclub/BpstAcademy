}

@section Head {
    <script type="application/ld+json">
      {
          "@@context": "https://schema.org",
          "@@type": "BreadcrumbList",
          "itemListElement": [
            { "@@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.bpstacademy.com/" },
            {
              "@@type": "ListItem",
              "position": 2,
              "name": "Industrial Training",
              "item": "https://www.bpstacademy.com/industrial-training"
            },
            {
              "@@type": "ListItem",
              "position": 3,
              "name": "Software Development & Full Stack",
              "item": "https://www.bpstacademy.com/courses/full-stack-development"
            }
          ]
        }
    </script>
    <script type="application/ld+json">
      {
          "@@context": "https://schema.org",
          "@@type": "Course",
          "@@id": "https://www.bpstacademy.com/courses/full-stack-development#course",
          "name": "Software Development & Full Stack (.NET + React)",
          "description": "Get practical, industry-oriented software development training that takes you from core programming fundamentals to modern web and backend engineering, with hands-on projects, real tools, and industry best practices.",
          "url": "https://www.bpstacademy.com/courses/full-stack-development",
          "provider": {
            "@@type": "EducationalOrganization",
            "@@id": "https://www.bpstacademy.com/#organization",
            "name": "BPST Academy",
            "sameAs": "https://www.bpstacademy.com/"
          },
          "inLanguage": "en-IN",
          "availableLanguage": ["English", "Hindi"],
          "educationalLevel": "Beginner friendly",
          "teaches": ["C# & OOP", "Databases", "ASP.NET Core Web API", "React Front-end", "Architecture & Testing", "Deployment"],
          "coursePrerequisites": "No prior coding background required. We build fundamentals before moving to frameworks.",
          "educationalCredentialAwarded": "BitProSoftTech training certificate; 6-month program includes an internship letter",
          "timeRequired": "P13W",
          "syllabusSections": [
            {
              "@@type": "Syllabus",
              "name": "C# & OOP",
              "description": "Syntax, types, collections; Classes, interfaces, generics; LINQ & async/await; Exception handling"
            },
            {
              "@@type": "Syllabus",
              "name": "Databases",
              "description": "SQL Server design & normalization; Joins, views, stored procedures; Entity Framework Core; Query optimization"
            },
            {
              "@@type": "Syllabus",
              "name": "ASP.NET Core Web API",
              "description": "REST principles; Controllers, DI, middleware; JWT auth & role-based access; Swagger documentation"
            },
            {
              "@@type": "Syllabus",
              "name": "React Front-end",
              "description": "Components, hooks, state; Routing & forms; Consuming APIs; Bootstrap 5 UI"
            },
            {
              "@@type": "Syllabus",
              "name": "Architecture & Testing",
              "description": "Layered / clean architecture; Unit tests (xUnit); Microservices intro; Logging & error handling"
            },
            {
              "@@type": "Syllabus",
              "name": "Deployment",
              "description": "Git branching & PRs; Docker containers; CI/CD with GitHub Actions; Cloud hosting + domain + SSL"
            }
          ],
          "image": "https://www.bpstacademy.com/site/img/og-bpst-diwali.png",
          "offers": [
            {
              "@@type": "Offer",
              "category": "Pre-booking",
              "name": "Diwali seat pre-booking (adjusted in course fee)",
              "price": "49",
              "priceCurrency": "INR",
              "availability": "https://schema.org/InStock",
              "validFrom": "2026-09-25",
              "validThrough": "2026-11-08T23:59:59+05:30",
              "url": "https://www.bpstacademy.com/prebook?course=full-stack-development"
            }
          ],
          "hasCourseInstance": [
            {
              "@@type": "CourseInstance",
              "courseMode": "Onsite",
              "courseWorkload": "P13W",
              "location": {
                "@@type": "Place",
                "name": "BPST Academy Lucknow",
                "address": {
                  "@@type": "PostalAddress",
                  "streetAddress": "3rd Floor, Sahay Complex, Near IIM Tiraha, Mubarakpur",
                  "addressLocality": "Lucknow",
                  "addressRegion": "Uttar Pradesh",
                  "postalCode": "226013",
                  "addressCountry": "IN"
                }
              }
            },
            {
              "@@type": "CourseInstance",
              "courseMode": "Online",
              "courseWorkload": "P13W",
              "location": { "@@type": "VirtualLocation", "url": "https://www.bpstacademy.com/online-courses" }
            }
          ]
        }
    </script>
    <script type="application/ld+json">
      {
          "@@context": "https://schema.org",
          "@@type": "FAQPage",
          "mainEntity": [
            {
              "@@type": "Question",
              "name": "What is the duration of the Software Development & Full Stack course at BPST Academy?",
              "acceptedAnswer": {
                "@@type": "Answer",
                "text": "Software Development & Full Stack runs for 45 Days · 3 Months · 6 Months. You can study in the Lucknow classroom (3rd Floor, Sahay Complex, Near IIM Tiraha) or join the same batch live online from anywhere in India."
              }
            },
            {
              "@@type": "Question",
              "name": "Who can join Software Development & Full Stack?",
              "acceptedAnswer": {
                "@@type": "Answer",
                "text": "B.Tech (CS/IT/ECE), BCA, MCA, Diploma students, fresh graduates, and career starters wanting complete end-to-end engineering skills. Prerequisite: No prior coding background required. We build fundamentals before moving to frameworks."
              }
            },
            {
              "@@type": "Question",
              "name": "What is the fee for Software Development & Full Stack, and what is the ₹49 pre-booking offer?",
              "acceptedAnswer": {
                "@@type": "Answer",
                "text": "The course fee depends on the duration and mode you choose and is shared with you on WhatsApp right after pre-booking. As a Diwali gift, you can reserve your seat for just ₹49 until 8 November 2026 (23:59 IST). The ₹49 is adjusted in your course fee."
              }
            },
            {
              "@@type": "Question",
              "name": "Will I get a certificate after Software Development & Full Stack?",
              "acceptedAnswer": {
                "@@type": "Answer",
                "text": "Yes. BitProSoftTech training certificate; 6-month program includes an internship letter. You also leave with project work you can show to employers."
              }
            },
            {
              "@@type": "Question",
              "name": "Does BPST Academy help with jobs after this course?",
              "acceptedAnswer": {
                "@@type": "Answer",
                "text": "Yes — we provide job assistance: resume and LinkedIn/Naukri profile reviews, mock technical and HR interviews, and relevant interview opportunities. We do not make placement-guarantee claims; we make sure your skills and portfolio are genuinely job-ready."
              }
            }
          ]
        }
    </script>
}

