@* Ported from NewLayout/Landing Page UI/courses/full-stack-development.html. *@
@{
    ViewData["Seo"] = new SeoMeta
    {
        Title = "Software Development & Full Stack Course in Lucknow | BPST Academy",
        Description = "Software Development & Full Stack course in Lucknow & online (45 Days · 3 Months · 6 Months). Pre-book for ₹49 till Diwali. Covers C# & OOP, Databases…",
