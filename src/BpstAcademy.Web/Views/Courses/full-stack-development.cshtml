        OgTitle = "Software Development & Full Stack (.NET + React) — BPST Academy (pre-book ₹49 till Diwali)",
        OgDescription = "Software Development & Full Stack course in Lucknow & online (45 Days · 3 Months · 6 Months). Pre-book for ₹49 till Diwali. Covers C# & OOP, Databases, ASP.NET Core Web API, React Front-end + live…",
        OgType = "article",
        OgImage = "/site/img/og-bpst-diwali.png",
        OgImageAlt = "BPST Academy — Diwali offer: pre-book any course for ₹49",
