@model string
@{
    var name = User.Identity?.Name ?? "User";
    var initials = string.Concat(name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => char.ToUpperInvariant(p[0])));
}
<header class="topbar">
    <button class="btn btn-ghost btn-icon" id="sidebarToggle" aria-label="Toggle menu" aria-controls="sidebar"><i class="bi bi-layout-sidebar"></i></button>
    <div class="topbar-title">@Model</div>
    <div class="ms-auto d-flex align-items-center gap-2">
        <button class="btn btn-ghost btn-icon" id="themeToggle" aria-label="Switch theme"><i class="bi bi-moon"></i></button>
        <div class="dropdown">
            <button class="btn btn-ghost p-0 rounded-circle" data-bs-toggle="dropdown" aria-label="Account menu"><span class="avatar">@initials</span></button>
            <div class="dropdown-menu dropdown-menu-end">
                <div class="px-3 py-2"><div class="fw-semibold">@name</div></div>
                <hr class="dropdown-divider">
                <form asp-area="Account" asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                    <button type="submit" class="dropdown-item"><i class="bi bi-box-arrow-right me-2"></i>Sign out</button>
                </form>
            </div>
        </div>
    </div>
</header>
