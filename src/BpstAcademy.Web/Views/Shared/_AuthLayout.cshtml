@* Sign-in pages (login, forgot / set password): portal styling without the sidebar. Never indexed. *@
@{
    var title = ViewData["Title"] as string ?? "Sign in";
}
<!doctype html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@title · BPST Academy</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href="~/portal/img/favicon.svg" type="image/svg+xml" />
    <script>try{var t=localStorage.getItem('bpst.theme');if(t)document.documentElement.setAttribute('data-bs-theme',t)}catch(e){}</script>
    <link rel="stylesheet" href="~/lib/bootstrap/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/portal/css/admin.css" asp-append-version="true" />
</head>
<body>
    <main class="auth" id="main">
        @RenderBody()
    </main>
    <script src="~/lib/bootstrap/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
