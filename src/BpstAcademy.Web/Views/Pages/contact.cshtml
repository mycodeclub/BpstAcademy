@* Ported from NewLayout/Landing Page UI/contact.html. *@
@{
    ViewData["Seo"] = new SeoMeta
    {
        Title = "Contact BPST Academy Lucknow — Address, Phone, WhatsApp",
        Description = "Visit BPST Academy at Sahay Complex, near IIM Tiraha, Lucknow. Call or WhatsApp +91 82991 01616. Open Monday – Saturday. Classroom and live online courses.",
        CanonicalPath = "/contact",
        OgImage = "/site/img/og-bpst-diwali.png",
        OgImageAlt = "BPST Academy — Diwali offer: pre-book any course for ₹49",
    };
}

@section Head {
    <script type="application/ld+json">
      {
          "@@context": "https://schema.org",
          "@@type": "BreadcrumbList",
          "itemListElement": [
            { "@@type": "ListItem", "position": 1, "name": "Home", "item": "https://edu.bitprosofttech.com/" },
            { "@@type": "ListItem", "position": 2, "name": "Contact", "item": "https://edu.bitprosofttech.com/contact" }
          ]
        }
    </script>
    <script type="application/ld+json">
      {
          "@@context": "https://schema.org",
          "@@type": "ContactPage",
          "name": "Contact BPST Academy",
          "url": "https://edu.bitprosofttech.com/contact",
          "about": { "@@id": "https://edu.bitprosofttech.com/#organization" }
        }
    </script>
}

<section class="bpst-page-hero">
  <div class="container">
    <nav class="bpst-crumbs" aria-label="Breadcrumb">
      <ol>
        <li><a href="/">Home</a></li>
        <li aria-current="page">Contact</li>
      </ol>
    </nav>
    <h1>Contact BPST Academy, Lucknow</h1>
    <p class="lead mb-0">
      Call <a class="text-warning" href="tel:+918299101616">+91 82991 01616</a>, WhatsApp us, or visit 3rd Floor, Sahay Complex, Near
      IIM Tiraha, Mubarakpur, Lucknow – 226013, Uttar Pradesh (Monday – Saturday).
    </p>
  </div>
</section>
<section class="py-5 bpst-section-light" id="enquiry">
  <div class="container">
    <div class="row g-5">
      <div class="col-lg-6">
        <h2 class="fw-bold mb-3">Send an Enquiry</h2>
        <p class="text-muted">
          Questions about a course, batch timings, fees or college training? Send a message and our admissions desk will reply on
          WhatsApp or phone.
        </p>
        <form class="bpst-form-card needs-validation" novalidate data-enquiry-form>
          <input type="text" name="website" class="d-none" tabindex="-1" autocomplete="off" aria-hidden="true" />
          <div class="row g-3">
            <div class="col-md-6">
              <label class="form-label" for="enq-name">Full Name *</label
              ><input id="enq-name" name="name" class="form-control" required minlength="2" autocomplete="name" />
              <div class="invalid-feedback">Please enter your name.</div>
            </div>
            <div class="col-md-6">
              <label class="form-label" for="enq-mobile">Mobile *</label>
              <div class="input-group">
                <span class="input-group-text bg-light">+91</span
                ><input
                  id="enq-mobile"
                  name="mobile"
                  type="tel"
                  inputmode="numeric"
                  pattern="[6-9][0-9]{9}"
                  maxlength="10"
                  class="form-control"
                  required
                  autocomplete="tel-national"
                />
              </div>
              <div class="invalid-feedback">Enter a valid 10-digit mobile.</div>
            </div>
            <div class="col-12">
              <label class="form-label" for="enq-course">Course</label
              ><select id="enq-course" name="course" class="form-select">
                <option value="">General enquiry</option>
                <optgroup label="Industrial Training">
                  <option value="full-stack-development">Software Development &amp; Full Stack (.NET + React)</option>
                  <option value="advanced-ui-angular-react">Advanced UI Development (Angular &amp; React)</option>
                  <option value="data-analytics-data-science">Data Analytics &amp; Data Science</option>
                  <option value="artificial-intelligence-machine-learning">Artificial Intelligence &amp; Machine Learning</option>
                  <option value="generative-ai-agentic-ai">Generative AI &amp; Agentic AI</option>
                  <option value="cloud-computing-devops">Cloud Computing &amp; DevOps</option>
                  <option value="cyber-security-ethical-hacking">Cyber Security &amp; Ethical Hacking</option>
                  <option value="mobile-app-development">Mobile App Development (Android &amp; iOS)</option>
                  <option value="game-development-unity">Game Development (Unity + C#)</option>
                </optgroup>
                <optgroup label="AI &amp; Generative AI">
                  <option value="agentic-ai-engineering">Agentic AI Engineering</option>
                  <option value="generative-ai-for-everyone">Generative AI for Everyone (Prompt Engineering)</option>
                  <option value="mlops-llmops">MLOps &amp; LLMOps</option>
                  <option value="artificial-intelligence-specialization">Artificial Intelligence (AI + Generative AI)</option>
                  <option value="machine-learning-specialization">Machine Learning</option>
                </optgroup>
                <optgroup label="Data Analytics &amp; Engineering">
                  <option value="data-analyst-pro">Data Analyst Pro (Excel + SQL + Power BI + Tableau + Python)</option>
                  <option value="data-engineering">Data Engineering (Spark, Databricks, Snowflake, Azure/AWS)</option>
                </optgroup>
                <optgroup label="Cloud &amp; DevOps">
                  <option value="devops-sre-terraform">DevOps + SRE + Terraform</option>
                  <option value="google-cloud-engineer">Google Cloud (GCP) Cloud Engineer</option>
                  <option value="cloud-certification-bootcamp">
                    Cloud Certification Bootcamp (AZ-900, AZ-104, AWS CCP, AWS SAA)
                  </option>
                </optgroup>
                <optgroup label="Cyber Security &amp; Networking">
                  <option value="soc-analyst">SOC Analyst (Blue Team)</option>
                  <option value="ethical-hacking-vapt">Ethical Hacking &amp; VAPT (CEH Preparation)</option>
                  <option value="cloud-security">Cloud Security (AWS &amp; Azure)</option>
                  <option value="ccna-network-security">CCNA + Network Security</option>
                </optgroup>
                <optgroup label="Full Stack Development">
                  <option value="mern-full-stack-genai">MERN Full Stack + Generative AI</option>
                  <option value="java-full-stack">Java Full Stack (Spring Boot + React)</option>
                  <option value="python-full-stack">Python Full Stack (Django + React)</option>
                  <option value="golang-microservices">Golang Microservices</option>
                </optgroup>
                <optgroup label="Software Testing &amp; QA">
                  <option value="software-testing-masters">Software Testing Masters (Manual + Selenium + Playwright + API)</option>
                  <option value="manual-software-testing">Manual Software Testing</option>
                  <option value="automation-testing-selenium-playwright">Automation Testing (Selenium + Playwright)</option>
                </optgroup>
                <optgroup label="SAP, Salesforce &amp; Enterprise IT">
                  <option value="sap-s4hana-fico">SAP S/4HANA FICO</option>
                  <option value="sap-mm-sd">SAP MM &amp; SD (Materials Management + Sales &amp; Distribution)</option>
                  <option value="sap-abap-s4hana">SAP ABAP on S/4HANA (RAP, CDS)</option>
                  <option value="salesforce-admin-developer">Salesforce Admin + Developer (with Agentforce)</option>
                  <option value="servicenow-admin-developer">ServiceNow Admin + Developer</option>
                  <option value="rpa-uipath-agentic-automation">RPA with UiPath + Agentic Automation</option>
                  <option value="oracle-sql-plsql">Oracle SQL + PL/SQL</option>
                </optgroup>
                <optgroup label="Business, Design, Marketing &amp; Accounting">
                  <option value="digital-marketing-ai">Digital Marketing + AI (SEO, GEO, Ads)</option>
                  <option value="ui-ux-design-figma">UI/UX Design (Figma + AI)</option>
                  <option value="business-analyst-agile">Business Analyst (with Agile)</option>
                  <option value="ai-product-management">AI Product Management</option>
                  <option value="tally-prime-gst-excel">Tally Prime + GST + Advanced Excel</option>
                </optgroup>
                <optgroup label="Programming Languages">
                  <option value="c-programming-course">C Programming Course (Basic &amp; Advanced)</option>
                  <option value="cpp-programming-course">C++ Programming Course (Basic &amp; Advanced)</option>
                  <option value="java-programming-course">Java Programming Course (Basic &amp; Advanced)</option>
                  <option value="python-programming-course">Python Programming Course (Basic &amp; Advanced)</option>
                </optgroup>
                <optgroup label="School Coding &amp; Robotics">
                  <option value="robotics-coding-ai-for-kids">Robotics, Coding &amp; AI for Kids (Grades 3–12)</option>
                  <option value="python-coding-class-9-10">Coding Foundations with Python</option>
                  <option value="cbse-computer-science-python-class-11-12">Computer Science with Python (CBSE)</option>
                  <option value="icse-isc-java-computer-applications">Computer Applications &amp; Science with Java</option>
                  <option value="engineering-headstart-c-cpp">Engineering Head-start: C, C++ &amp; Problem Solving</option>
                </optgroup>
                <optgroup label="College Programs">
                  <option value="btech-career-track">B.Tech Career Track</option>
                  <option value="bca-career-track">BCA Career Track</option>
                  <option value="mca-industry-track">MCA Industry Track</option>
                  <option value="polytechnic-diploma-track">Polytechnic Diploma Track</option>
                </optgroup>
                <optgroup label="Career &amp; Placement Readiness">
                  <option value="dsa-placement-preparation">DSA &amp; Placement Preparation</option>
                  <option value="job-readiness-program">Job-Readiness Program (Communication, Resume, Mock Interviews)</option>
                </optgroup>
                <optgroup label="Summer &amp; Winter Training">
                  <option value="summer-winter-training-45-days">45-Day Summer / Winter Industrial Training</option>
                </optgroup>
              </select>
            </div>
            <div class="col-12">
              <label class="form-label" for="enq-msg">Message</label
              ><textarea id="enq-msg" name="message" class="form-control" rows="3"></textarea>
            </div>
            <div class="col-12">
              <div class="form-check">
                <input class="form-check-input" type="checkbox" id="enq-consent" name="consent" value="yes" required /><label
                  class="form-check-label small text-muted"
                  for="enq-consent"
                  >I agree to be contacted on phone/WhatsApp about my enquiry (<a href="/privacy">privacy policy</a>).</label
                >
              </div>
            </div>
            <div class="col-12">
              <button class="btn btn-bpst-primary btn-lg w-100" type="submit"><i class="bi bi-send-fill"></i> Send Enquiry</button>
            </div>
          </div>
          <div class="alert alert-success mt-3 mb-0 d-none" data-enquiry-ok role="status">
            <i class="bi bi-check-circle-fill"></i> Thank you! We will contact you shortly on WhatsApp/phone.
          </div>
        </form>
      </div>
      <div class="col-lg-6">
        <div class="bpst-diwali-card mb-4 bpst-offer-live">
          <div class="d-flex align-items-center gap-3 mb-2">
            <span class="bpst-diya" aria-hidden="true"></span>
            <div>
              <div class="small fw-bold text-uppercase" style="letter-spacing: 0.08em; color: #fcd34d">Ready to join?</div>
              <div class="h4 text-white mb-0">Skip the queue — pre-book for ₹49</div>
            </div>
          </div>
          <p class="small mb-3" style="color: #fde68a">Lock your seat before Diwali; the ₹49 is adjusted in your course fee.</p>
          <a class="btn btn-bpst-gold w-100 fw-bold" href="/prebook">Pre-book now</a>
        </div>
        <div class="bpst-card">
          <h2 class="h5 fw-bold">Reach us directly</h2>
          <ul class="list-unstyled small mb-0">
            <li class="mb-2">
              <i class="bi bi-telephone-fill text-primary me-2"></i><a href="tel:+918299101616">+91 82991 01616</a> ·
              <a href="tel:+916394636206">+91 63946 36206</a>
            </li>
            <li class="mb-2">
              <i class="bi bi-whatsapp text-success me-2"></i
              ><a href="https://wa.me/918299101616?text=Hello%20BPST%20Academy" target="_blank" rel="noopener"
                >WhatsApp admissions desk</a
              >
            </li>
            <li class="mb-2">
              <i class="bi bi-envelope-fill text-warning me-2"></i
              ><a href="mailto:bitprosofttech@@gmail.com">bitprosofttech@@gmail.com</a>
            </li>
            <li class="mb-2"><i class="bi bi-clock-fill text-info me-2"></i>Monday – Saturday</li>
            <li>
              <i class="bi bi-geo-alt-fill text-danger me-2"></i>3rd Floor, Sahay Complex, Near IIM Tiraha, Mubarakpur, Lucknow –
              226013, Uttar Pradesh
            </li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="py-5 bpst-section-light" id="contact" aria-labelledby="contact-title">
  <div class="container py-4">
    <div class="text-center max-w-700 mx-auto mb-5">
      <span class="bpst-pill bpst-pill-gold mb-2">Visit Us Today</span>
      <h2 class="fw-bold" id="contact-title">Where Is the BPST Training Centre in Lucknow?</h2>
      <p class="text-muted">
        BPST Academy is at 3rd Floor, Sahay Complex, Near IIM Tiraha, Mubarakpur, Lucknow – 226013, Uttar Pradesh — near IIM Tiraha in
        Mubarakpur, open Monday – Saturday. Drop by to meet mentors and see our software teams in action.
      </p>
    </div>
    <div class="row g-4 align-items-stretch">
      <div class="col-lg-5">
        <div class="bpst-card h-100 d-flex flex-column justify-content-between">
          <div>
            <div class="d-flex align-items-center gap-2 mb-3">
              <div class="bg-primary rounded-circle p-2 text-white"><i class="bi bi-geo-alt-fill fs-4"></i></div>
              <div>
                <h3 class="h5 fw-bold mb-0">Centre Location</h3>
                <span class="badge bg-success-subtle text-success small">Open Monday – Saturday</span>
              </div>
            </div>
            <address class="p-3 bg-light rounded-3 mb-3 border">
              <strong class="d-block text-dark mb-1">BPST Academy (BPST Software Education)</strong>
              <span class="d-block mb-2 text-muted small"
                >3rd Floor, Sahay Complex,<br />Near IIM Tiraha, Mubarakpur,<br />Lucknow – 226013, Uttar Pradesh, India</span
              >
              <a
                href="https://maps.app.goo.gl/HBnbzEwxJ5npkkAfA"
                target="_blank"
                rel="noopener"
                class="btn btn-sm btn-primary w-100 py-1"
                ><i class="bi bi-geo-alt-fill me-1"></i> Open Location in Google Maps</a
              >
            </address>
            <div class="d-grid gap-2 mb-4">
              <a href="tel:+918299101616" class="btn btn-outline-primary btn-sm text-start"
                ><i class="bi bi-telephone-fill me-2 text-primary"></i> <strong>Call:</strong> +91 82991 01616</a
              >
              <a href="tel:+916394636206" class="btn btn-outline-secondary btn-sm text-start"
                ><i class="bi bi-telephone me-2"></i> <strong>Alt:</strong> +91 63946 36206</a
              >
              <a
                href="https://wa.me/918299101616?text=Hello%20BPST%20Academy%2C%20I%20want%20to%20visit%20your%20centre%20at%20Sahay%20Complex."
                target="_blank"
                rel="noopener"
                class="btn btn-outline-success btn-sm text-start"
                ><i class="bi bi-whatsapp me-2 text-success"></i> <strong>WhatsApp:</strong> Chat with Admissions Desk</a
              >
              <a href="mailto:bitprosofttech@@gmail.com" class="btn btn-outline-secondary btn-sm text-start"
                ><i class="bi bi-envelope-fill me-2 text-warning"></i> <strong>Email:</strong> bitprosofttech@@gmail.com</a
              >
            </div>
          </div>
          <div class="p-3 rounded-3 border bg-white d-flex align-items-center gap-3">
            <img
              src="/site/img/bpst-location-qr.png"
              alt="QR code: BPST centre on Google Maps"
              width="84"
              height="84"
              loading="lazy"
              class="border rounded p-1 shadow-sm bg-white"
            />
            <div>
              <span class="badge bg-warning text-dark fw-bold mb-1">Quick Navigation</span>
              <p class="mb-1 fw-bold text-dark small">Scan for Centre Location</p>
              <a
                href="https://maps.app.goo.gl/HBnbzEwxJ5npkkAfA"
                target="_blank"
                rel="noopener"
                class="small text-primary fw-semibold"
                >Open in Google Maps <i class="bi bi-box-arrow-up-right"></i
              ></a>
            </div>
          </div>
        </div>
      </div>
      <div class="col-lg-7">
        <div class="bpst-card h-100 p-0 overflow-hidden border shadow-sm d-flex flex-column">
          <div class="p-3 bg-white border-bottom d-flex justify-content-between align-items-center gap-2 flex-wrap">
            <div>
              <span class="fw-bold small text-dark"
                ><i class="bi bi-geo-alt-fill text-danger me-1"></i> BitProSoftTech Software Solutions</span
              ><span class="badge bg-success-subtle text-success small ms-2 d-none d-sm-inline">Near IIM Tiraha</span>
            </div>
            <a
              href="https://maps.app.goo.gl/HBnbzEwxJ5npkkAfA"
              target="_blank"
              rel="noopener"
              class="btn btn-sm btn-primary py-1 px-3"
              ><i class="bi bi-compass-fill me-1"></i> Get Directions</a
            >
          </div>
          <div class="bpst-map-frame flex-grow-1">
            <iframe
              src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3556.7646696144883!2d80.9063644!3d26.9314862!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3999568c98ff4257%3A0x30b1a198dd18f798!2sBitProSoftTech%20Software%20Solutions!5e0!3m2!1sen!2sin!4v1710000000000!5m2!1sen!2sin"
              allowfullscreen
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              title="Map: BPST Academy training centre at Sahay Complex, near IIM Tiraha, Lucknow"
            ></iframe>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
