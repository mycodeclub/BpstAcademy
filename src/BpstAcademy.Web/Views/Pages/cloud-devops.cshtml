@* Ported from NewLayout/Landing Page UI/cloud-devops.html. *@
@{
    ViewData["Seo"] = new SeoMeta
    {
        Title = "Cloud & DevOps Courses in Lucknow — AWS, Azure, GCP, Kubernetes",
        Description = "AWS, Azure and Google Cloud certification bootcamps, plus DevOps + SRE with Docker, Kubernetes, Terraform, GitHub Actions and observability.",
        CanonicalPath = "/cloud-devops",
        OgImage = "/site/img/og-bpst-diwali.png",
        OgImageAlt = "BPST Academy — Diwali offer: pre-book any course for ₹49",
    };
}

@section Head {
    <script type="application/ld+json">
      {
          "@@context": "https://schema.org",
          "@@type": "BreadcrumbList",
          "itemListElement": [
            { "@@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.bpstacademy.com/" },
            { "@@type": "ListItem", "position": 2, "name": "Programs", "item": "https://www.bpstacademy.com/courses" },
            { "@@type": "ListItem", "position": 3, "name": "Cloud & DevOps", "item": "https://www.bpstacademy.com/cloud-devops" }
          ]
        }
    </script>
    <script type="application/ld+json">
      {
          "@@context": "https://schema.org",
          "@@type": "ItemList",
          "name": "Cloud & DevOps courses at BPST Academy",
          "itemListElement": [
            {
              "@@type": "ListItem",
              "position": 1,
              "url": "https://www.bpstacademy.com/courses/devops-sre-terraform",
              "name": "DevOps + SRE + Terraform"
            },
            {
              "@@type": "ListItem",
              "position": 2,
              "url": "https://www.bpstacademy.com/courses/google-cloud-engineer",
              "name": "Google Cloud (GCP) Cloud Engineer"
            },
            {
              "@@type": "ListItem",
              "position": 3,
              "url": "https://www.bpstacademy.com/courses/cloud-certification-bootcamp",
              "name": "Cloud Certification Bootcamp (AZ-900, AZ-104, AWS CCP, AWS SAA)"
            }
          ]
        }
    </script>
    <script type="application/ld+json">
      {
          "@@context": "https://schema.org",
          "@@type": "FAQPage",
          "mainEntity": [
            {
              "@@type": "Question",
              "name": "Which cloud certification should I do first?",
              "acceptedAnswer": {
                "@@type": "Answer",
                "text": "Start with AZ-900 or AWS Cloud Practitioner if you are new to cloud. Developers and admins with some Linux experience can go straight to AZ-104 or AWS Solutions Architect Associate."
              }
            },
            {
              "@@type": "Question",
              "name": "Is exam fee included?",
              "acceptedAnswer": {
                "@@type": "Answer",
                "text": "No. Exam vouchers are paid directly to Microsoft, AWS or Google. We help you register and run mock exams before your attempt."
              }
            }
          ]
        }
    </script>
}

