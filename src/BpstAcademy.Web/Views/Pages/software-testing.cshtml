    {
        Title = "Software Testing Course in Lucknow — Manual, Selenium, Playwright",
        Description = "Manual testing, Selenium with Java, Playwright, API testing and CI — the most accessible route into IT for non-CS graduates. Pre-book for ₹49 till Diwali.",
