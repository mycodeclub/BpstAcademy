      {
          "@@context": "https://schema.org",
          "@@type": "BreadcrumbList",
          "itemListElement": [
            { "@@type": "ListItem", "position": 1, "name": "Home", "item": "https://edu.bitprosofttech.com/" },
            { "@@type": "ListItem", "position": 2, "name": "Programs", "item": "https://edu.bitprosofttech.com/courses" },
            {
              "@@type": "ListItem",
              "position": 3,
              "name": "Software Testing & QA",
              "item": "https://edu.bitprosofttech.com/software-testing"
            }
          ]
        }
    </script>
    <script type="application/ld+json">
      {
          "@@context": "https://schema.org",
          "@@type": "ItemList",
          "name": "Software Testing & QA courses at BPST Academy",
          "itemListElement": [
            {
              "@@type": "ListItem",
              "position": 1,
              "url": "https://edu.bitprosofttech.com/courses/software-testing-masters",
              "name": "Software Testing Masters (Manual + Selenium + Playwright + API)"
