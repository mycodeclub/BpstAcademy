                    <li>Big-O time &amp; space</li>
                    <li>Recursion</li>
                    <li>Maths for DSA</li>
                    <li>Bit manipulation</li>
                  </ul>
                </div>
              </div>
              <div class="col-md-6 col-xl-4">
                <div class="module">
                  <div class="mno">Module 02</div>
                  <div class="mt">Linear Structures</div>
                  <ul>
                    <li>Arrays &amp; strings</li>
                    <li>Two pointers, sliding window</li>
                    <li>Linked lists</li>
                    <li>Stacks &amp; queues</li>
                  </ul>
                </div>
              </div>
              <div class="col-md-6 col-xl-4">
