      {
          "@@context": "https://schema.org",
          "@@type": "BreadcrumbList",
          "itemListElement": [
            { "@@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.bpstacademy.com/" },
            { "@@type": "ListItem", "position": 2, "name": "Programs", "item": "https://www.bpstacademy.com/courses" },
            {
              "@@type": "ListItem",
              "position": 3,
              "name": "Career & Placement Readiness",
              "item": "https://www.bpstacademy.com/career-placement"
            }
          ]
        }
    </script>
    <script type="application/ld+json">
      {
          "@@context": "https://schema.org",
          "@@type": "ItemList",
          "name": "Career & Placement Readiness courses at BPST Academy",
          "itemListElement": [
            {
              "@@type": "ListItem",
              "position": 1,
              "url": "https://www.bpstacademy.com/courses/dsa-placement-preparation",
              "name": "DSA & Placement Preparation"
            },
            {
              "@@type": "ListItem",
              "position": 2,
              "url": "https://www.bpstacademy.com/courses/job-readiness-program",
              "name": "Job-Readiness Program (Communication, Resume, Mock Interviews)"
            }
          ]
        }
    </script>
    <script type="application/ld+json">
      {
          "@@context": "https://schema.org",
          "@@type": "FAQPage",
          "mainEntity": [
            {
              "@@type": "Question",
