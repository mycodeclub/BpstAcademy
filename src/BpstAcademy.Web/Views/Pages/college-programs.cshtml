@* Ported from NewLayout/Landing Page UI/college-programs.html. *@
@{
    ViewData["Seo"] = new SeoMeta
    {
        Title = "College Career Tracks — B.Tech, BCA, MCA, Polytechnic | BPST Academy",
        Description = "Semester-wise skill tracks mapped to your degree year, with internships, training certificates and placement preparation. Pre-book for ₹49 till Diwali.",
        CanonicalPath = "/college-programs",
        OgImage = "/site/img/og-bpst-diwali.png",
        OgImageAlt = "BPST Academy — Diwali offer: pre-book any course for ₹49",
    };
}

@section Head {
    <script type="application/ld+json">
      {
          "@@context": "https://schema.org",
          "@@type": "BreadcrumbList",
          "itemListElement": [
            { "@@type": "ListItem", "position": 1, "name": "Home", "item": "https://edu.bitprosofttech.com/" },
            { "@@type": "ListItem", "position": 2, "name": "Programs", "item": "https://edu.bitprosofttech.com/courses" },
            { "@@type": "ListItem", "position": 3, "name": "College Programs", "item": "https://edu.bitprosofttech.com/college-programs" }
          ]
        }
    </script>
    <script type="application/ld+json">
      {
          "@@context": "https://schema.org",
          "@@type": "ItemList",
          "name": "College Programs courses at BPST Academy",
          "itemListElement": [
            {
              "@@type": "ListItem",
              "position": 1,
              "url": "https://edu.bitprosofttech.com/courses/btech-career-track",
              "name": "B.Tech Career Track"
            },
            {
              "@@type": "ListItem",
              "position": 2,
              "url": "https://edu.bitprosofttech.com/courses/bca-career-track",
              "name": "BCA Career Track"
            },
            {
              "@@type": "ListItem",
              "position": 3,
              "url": "https://edu.bitprosofttech.com/courses/mca-industry-track",
              "name": "MCA Industry Track"
            },
            {
              "@@type": "ListItem",
              "position": 4,
              "url": "https://edu.bitprosofttech.com/courses/polytechnic-diploma-track",
              "name": "Polytechnic Diploma Track"
            }
          ]
        }
    </script>
    <script type="application/ld+json">
      {
          "@@context": "https://schema.org",
          "@@type": "FAQPage",
          "mainEntity": [
            {
              "@@type": "Question",
              "name": "When should a B.Tech student start industry training?",
              "acceptedAnswer": {
                "@@type": "Answer",
                "text": "Ideally from the 2nd year, so you have two portfolio projects and an internship before final-year placements begin."
              }
            }
          ]
        }
    </script>
}

