            { "@@type": "ListItem", "position": 2, "name": "Programs", "item": "https://edu.bitprosofttech.com/courses" },
            {
              "@@type": "ListItem",
              "position": 3,
              "name": "Data Analytics & Engineering",
              "item": "https://edu.bitprosofttech.com/data-analytics-engineering"
            }
          ]
        }
    </script>
    <script type="application/ld+json">
      {
          "@@context": "https://schema.org",
          "@@type": "ItemList",
          "name": "Data Analytics & Engineering courses at BPST Academy",
          "itemListElement": [
            {
              "@@type": "ListItem",
              "position": 1,
              "url": "https://edu.bitprosofttech.com/courses/data-analyst-pro",
              "name": "Data Analyst Pro (Excel + SQL + Power BI + Tableau + Python)"
