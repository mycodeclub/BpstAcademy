@* Ported from NewLayout/Landing Page UI/cyber-security.html. *@
@{
    ViewData["Seo"] = new SeoMeta
    {
        Title = "Cyber Security, Ethical Hacking, SOC & CCNA Courses in Lucknow",
        Description = "Blue team (SOC analyst), red team (ethical hacking & VAPT), cloud security and CCNA networking — hands-on in a lab, mapped to CEH, Security+, SC-200, AZ-500…",
        CanonicalPath = "/cyber-security",
        OgDescription = "Blue team (SOC analyst), red team (ethical hacking & VAPT), cloud security and CCNA networking — hands-on in a lab, mapped to CEH, Security+, SC-200, AZ-500 and CCNA.",
        OgImage = "/site/img/og-bpst-diwali.png",
        OgImageAlt = "BPST Academy — Diwali offer: pre-book any course for ₹49",
    };
}

@section Head {
    <script type="application/ld+json">
      {
          "@@context": "https://schema.org",
          "@@type": "BreadcrumbList",
          "itemListElement": [
            { "@@type": "ListItem", "position": 1, "name": "Home", "item": "https://edu.bitprosofttech.com/" },
            { "@@type": "ListItem", "position": 2, "name": "Programs", "item": "https://edu.bitprosofttech.com/courses" },
            {
              "@@type": "ListItem",
              "position": 3,
              "name": "Cyber Security & Networking",
              "item": "https://edu.bitprosofttech.com/cyber-security"
            }
          ]
        }
    </script>
    <script type="application/ld+json">
      {
          "@@context": "https://schema.org",
          "@@type": "ItemList",
          "name": "Cyber Security & Networking courses at BPST Academy",
          "itemListElement": [
            {
              "@@type": "ListItem",
              "position": 1,
              "url": "https://edu.bitprosofttech.com/courses/soc-analyst",
              "name": "SOC Analyst (Blue Team)"
            },
            {
              "@@type": "ListItem",
              "position": 2,
              "url": "https://edu.bitprosofttech.com/courses/ethical-hacking-vapt",
              "name": "Ethical Hacking & VAPT (CEH Preparation)"
            },
            {
              "@@type": "ListItem",
              "position": 3,
              "url": "https://edu.bitprosofttech.com/courses/cloud-security",
              "name": "Cloud Security (AWS & Azure)"
            },
            {
              "@@type": "ListItem",
              "position": 4,
              "url": "https://edu.bitprosofttech.com/courses/ccna-network-security",
              "name": "CCNA + Network Security"
            }
          ]
        }
    </script>
    <script type="application/ld+json">
      {
          "@@context": "https://schema.org",
          "@@type": "FAQPage",
          "mainEntity": [
            {
              "@@type": "Question",
              "name": "Is ethical hacking legal to learn?",
              "acceptedAnswer": {
                "@@type": "Answer",
                "text": "Yes. You practise only on our own lab machines and intentionally vulnerable targets, and you learn the legal and ethical rules of authorised penetration testing."
              }
            },
            {
              "@@type": "Question",
              "name": "Which is better for jobs — SOC analyst or ethical hacker?",
              "acceptedAnswer": {
                "@@type": "Answer",
                "text": "SOC analyst roles have more openings for freshers because every company needs monitoring. Ethical hacking (VAPT) roles pay well but usually expect a portfolio or certification such as CEH or eJPT."
              }
            }
          ]
        }
    </script>
}

