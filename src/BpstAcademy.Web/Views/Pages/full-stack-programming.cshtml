    <script type="application/ld+json">
      {
          "@@context": "https://schema.org",
          "@@type": "FAQPage",
          "mainEntity": [
            {
              "@@type": "Question",
              "name": "Which full stack course has the most jobs in India?",
              "acceptedAnswer": {
                "@@type": "Answer",
                "text": "Java full stack is the largest hiring pool in IT services companies; MERN is most common in startups; .NET is strong in enterprise and product companies. All three are good choices — pick the stack that matches the companies you target."
