            { "@@type": "ListItem", "position": 1, "name": "Home", "item": "https://edu.bitprosofttech.com/" },
            { "@@type": "ListItem", "position": 2, "name": "Programs", "item": "https://edu.bitprosofttech.com/courses" },
            {
              "@@type": "ListItem",
              "position": 3,
              "name": "Full Stack Development",
              "item": "https://edu.bitprosofttech.com/full-stack-programming"
            }
          ]
        }
    </script>
    <script type="application/ld+json">
      {
          "@@context": "https://schema.org",
          "@@type": "ItemList",
          "name": "Full Stack Development courses at BPST Academy",
          "itemListElement": [
            {
              "@@type": "ListItem",
              "position": 1,
              "url": "https://edu.bitprosofttech.com/courses/mern-full-stack-genai",
              "name": "MERN Full Stack + Generative AI"
            },
            {
              "@@type": "ListItem",
              "position": 2,
              "url": "https://edu.bitprosofttech.com/courses/java-full-stack",
