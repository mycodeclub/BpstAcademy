@* Ported from NewLayout/Landing Page UI/online-courses.html. *@
@{
    ViewData["Seo"] = new SeoMeta
    {
        Title = "Live Online IT Courses — All India | BPST Academy",
        Description = "Live instructor-led online classes for all 58 BPST Academy courses: AI, data, cloud, testing, SAP, full stack. Same projects and certificate. Pre-book ₹49.",
        CanonicalPath = "/online-courses",
        OgImage = "/site/img/og-bpst-diwali.png",
        OgImageAlt = "BPST Academy — Diwali offer: pre-book any course for ₹49",
    };
}

@section Head {
    <script type="application/ld+json">
      {
          "@@context": "https://schema.org",
          "@@type": "BreadcrumbList",
          "itemListElement": [
            { "@@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.bpstacademy.com/" },
            {
              "@@type": "ListItem",
              "position": 2,
              "name": "Live Online Classes",
              "item": "https://www.bpstacademy.com/online-courses"
            }
          ]
        }
    </script>
    <script type="application/ld+json">
      {
          "@@context": "https://schema.org",
          "@@type": "FAQPage",
          "mainEntity": [
            {
              "@@type": "Question",
              "name": "Are BPST Academy online classes live or recorded?",
              "acceptedAnswer": {
                "@@type": "Answer",
                "text": "Live. Online learners join the same instructor-led batch as the Lucknow classroom, with screen sharing, doubt-solving, team projects and code reviews."
              }
            },
            {
              "@@type": "Question",
              "name": "Can I join from outside Uttar Pradesh?",
              "acceptedAnswer": {
                "@@type": "Answer",
                "text": "Yes. Live online batches are open to learners anywhere in India, including Bihar, Uttarakhand, Madhya Pradesh, Delhi NCR and Rajasthan."
              }
            },
            {
              "@@type": "Question",
              "name": "What do I need for online classes?",
              "acceptedAnswer": {
                "@@type": "Answer",
                "text": "A laptop or desktop (8 GB RAM recommended for development courses), a stable internet connection and a headset."
              }
            }
          ]
        }
    </script>
}

