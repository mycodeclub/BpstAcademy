@model LoginInput
@inject IWebHostEnvironment Env
@{
    ViewData["Title"] = "Sign in";
}

<section class="auth-panel">
    <div class="auth-form">
        <img src="~/portal/img/bpst-logo.svg" alt="BPST Software Education" height="36" class="mb-4 logo-on-light">
        <img src="~/portal/img/bpst-logo-white.svg" alt="BPST Software Education" height="36" class="mb-4 logo-on-dark">
        <h1>Sign in</h1>
        <p class="text-muted mb-4">Staff, trainers and students all sign in here.</p>

        <form asp-action="Login" method="post" novalidate>
            <input type="hidden" asp-for="ReturnUrl" />
            <div asp-validation-summary="ModelOnly" class="text-warning small mb-3" role="alert"></div>
            <div class="mb-3">
                <label class="form-label" asp-for="LoginId"></label>
                <input class="form-control" asp-for="LoginId" autocomplete="username" placeholder="you@@example.com or BPST26S0001">
                <span class="invalid-feedback d-block" asp-validation-for="LoginId"></span>
            </div>
            <div class="mb-2">
                <label class="form-label" asp-for="Password"></label>
                <div class="input-group">
                    <input class="form-control" asp-for="Password" autocomplete="current-password">
                    <button class="btn btn-outline-secondary" type="button" id="pwShow" aria-label="Show password"><i class="bi bi-eye"></i></button>
                </div>
                <span class="invalid-feedback d-block" asp-validation-for="Password"></span>
            </div>
            <div class="form-check mb-3">
                <input class="form-check-input" asp-for="RememberMe">
                <label class="form-check-label" asp-for="RememberMe"></label>
            </div>
            <button class="btn btn-primary w-100" type="submit">Sign in</button>
            <p class="caption mt-2 mb-0">New students and employees get a temporary password by email and set their own at first sign-in.</p>
        </form>

        @if (Env.IsDevelopment())
        {
            <hr class="my-4">
            <div class="eyebrow mb-2">Development only</div>
            <form asp-action="DemoSignIn" method="post">
                <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                <button class="btn btn-outline-secondary w-100" type="submit"><i class="bi bi-person-badge me-1"></i>Sign in as demo user</button>
            </form>
        }

        <nav class="d-flex flex-wrap gap-3 justify-content-center small mt-4" aria-label="More">
            <a href="/"><i class="bi bi-arrow-left me-1"></i>BPST Edu website</a>
            <a href="/verify"><i class="bi bi-patch-check me-1"></i>Verify a certificate</a>
            <a href="tel:+918299101616"><i class="bi bi-telephone me-1"></i>Help: 8299101616</a>
        </nav>
    </div>
</section>

<aside class="auth-aside" aria-label="About this portal">
    <div class="auth-aside-inner">
        <div class="eyebrow mb-2">BPST Edu Portal</div>
        <h2 class="h1 mb-3">Every lead answered within the hour.</h2>
        <p class="text-muted mb-4">One place for enquiries, counselling, admissions, fees, attendance, HR and payroll, with portals for trainers, students and staff.</p>
        <ul class="list-unstyled small text-muted mb-0 d-grid gap-2">
            <li><i class="bi bi-shield-check me-2 text-success"></i>Documents checked in person before anyone gets an ID card</li>
            <li><i class="bi bi-receipt me-2 text-success"></i>GST receipts, instalments, fines and waivers with approval</li>
            <li><i class="bi bi-calendar-check me-2 text-success"></i>Batches without timing clashes, attendance and payslips</li>
        </ul>
    </div>
</aside>

@section Scripts {
    <script>
        document.getElementById('pwShow').addEventListener('click', function () {
            var pw = document.getElementById('Password'), show = pw.type === 'password';
            pw.type = show ? 'text' : 'password';
            this.setAttribute('aria-label', show ? 'Hide password' : 'Show password');
            this.innerHTML = '<i class="bi ' + (show ? 'bi-eye-slash' : 'bi-eye') + '"></i>';
        });
    </script>
}
